{
  "name": "agent-on-a-leash",
  "version": "0.1.0",
  "description": "An autonomous AI agent that can be fully hijacked — and still cannot move your funds. Built on the Ledger Agent Stack (Device Management Kit + Solana Signer Kit + Speculos).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/agent.cjs",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --conditions=import --target=node20 --outfile=dist/agent.cjs --sourcemap",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "demo": "npm run build && node --no-deprecation dist/agent.cjs",
    "start": "node --no-deprecation dist/agent.cjs"
  },
  "keywords": [
    "ledger",
    "solana",
    "ai-agent",
    "device-management-kit",
    "speculos",
    "security",
    "prompt-injection"
  ],
  "dependencies": {
    "@ledgerhq/device-management-kit": "^1.7.1",
    "@ledgerhq/device-signer-kit-solana": "^1.9.1",
    "@ledgerhq/device-transport-kit-speculos": "^1.2.1",
    "@ledgerhq/speculos-device-controller": "^0.3.0",
    "dotenv": "^16.4.5",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.0"
  }
}
