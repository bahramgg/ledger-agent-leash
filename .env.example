# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file or real API keys.

# --- LLM (the agent's reasoning) ---
# Your LLM API key, read from the environment and never committed.
# Only needed once the LLM-backed brain is wired in; the bundled scenarios run
# deterministically without it.
LLM_API_KEY=your-llm-api-key-here

# --- Solana ---
# Devnet ONLY. Never point this at mainnet.
SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Speculos (Ledger device emulator) ---
# The Speculos instance the real signer talks to.
SPECULOS_API_URL=http://localhost:5000

# --- Signer mode ---
# Set to true to use the labelled MOCK signer (no real device / Speculos needed).
# Leave false (or unset) to use the real Speculos-backed signer.
USE_MOCK_SIGNER=false

# When true, getAddress asks the device to display the address for on-screen
# verification (requires confirming on the device). Default false.
CHECK_ADDRESS_ON_DEVICE=false

# --- Web server ---
# Port the web dashboard/API listens on (deploy hosts set this automatically).
PORT=3000

# A REAL ed25519 signature captured from Speculos at dev/build time. Because
# Speculos can't run on a typical public host, when the live signer is the mock
# the dashboard shows this captured-real signature, clearly labelled. Paste a
# base58 signature here (see docs/speculos.md). Leave empty to show the mock sig.
SPECULOS_SIGNATURE=
# Optional override for the note shown beneath a captured signature.
SPECULOS_SIGNATURE_NOTE=
